NEXLEXHUB_APP_NAME=NexLexHub
NEXLEXHUB_ENV=dev
NEXLEXHUB_API_KEY=dev-api-key
NEXLEXHUB_JWT_SECRET=change-me
NEXLEXHUB_JWT_ISSUER=nexlexhub
NEXLEXHUB_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexlexhub
NEXLEXHUB_SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nexlexhub
NEXLEXHUB_REDIS_URL=redis://localhost:6379/0
NEXLEXHUB_ALLOWED_KEYS=dev-api-key:admin,reader-key:reader
NEXLEXHUB_EMBEDDING_PROVIDER=hash
NEXLEXHUB_EMBEDDING_DIMENSION=16
NEXLEXHUB_RATE_LIMIT_PER_MINUTE=120
NEXLEXHUB_ENABLE_DEMO_SEED=true
NEXLEXHUB_AUTO_INIT_DB=true
